# Unity 文本化合并配置
# 必须配合 Unity Editor Settings: Asset Serialization Mode = Force Text 使用
# 还需要在 .git/config 配置 unityyamlmerge driver, 见 README

# Unity YAML 资源走 Smart Merge
*.unity merge=unityyamlmerge -text diff
*.prefab merge=unityyamlmerge -text diff
*.asset merge=unityyamlmerge -text diff
*.meta merge=unityyamlmerge -text diff
*.controller merge=unityyamlmerge -text diff
*.anim merge=unityyamlmerge -text diff
*.mat merge=unityyamlmerge -text diff
*.physicsMaterial merge=unityyamlmerge -text diff

# 二进制资源用 LFS（如果项目体积大，按需启用）
# *.png filter=lfs diff=lfs merge=lfs -text
# *.jpg filter=lfs diff=lfs merge=lfs -text
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.fbx filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text
# *.mp3 filter=lfs diff=lfs merge=lfs -text
# *.ogg filter=lfs diff=lfs merge=lfs -text

# 行尾自动转换：Windows 项目用 LF (避免 mac/linux 队友炸)
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
